{
  "schemaVersion": 1,
  "id": "proxy-web-mod",
  "version": "${version}",
  "name": "Proxy Web Mod",
  "description": "网页截图代理模组 — 自定义方块显示网页截图，纯 Fabric Java 代码，不依赖 CEF/native 库，FCL 可直接加载",
  "authors": [
    "mcef-android-fcl-port"
  ],
  "contact": {
    "homepage": "https://github.com/data7128/mcef-android-fcl-port",
    "sources": "https://github.com/data7128/mcef-android-fcl-port"
  },
  "license": "LGPL-2.1-or-later",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.cinemamod.mcef.proxy.ProxyWebMod"
    ],
    "client": [
      "com.cinemamod.mcef.proxy.ProxyWebModClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.7",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": ">=0.92.0"
  },
  "suggests": {
    "mcef": "*"
  }
}
